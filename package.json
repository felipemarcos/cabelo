{
  "name": "cabelo",
  "version": "0.2.1",
  "description": "Tiny, dependency-free library to animate anything based on the scroll position",
  "license": "MIT",
  "author": "Felipe Marcos (http://felipemarcos.com)",
  "repository": "felipemarcos/cabelo",
  "homepage": "https://felipemarcos.github.io/cabelo/",
  "bugs": "https://github.com/felipemarcos/cabelo/issues",
  "keywords": [
    "scroll",
    "parallax",
    "animation",
    "scroll-animation",
    "tween",
    "timeline",
    "css",
    "svg"
  ],
  "main": "dist/cabelo.js",
  "module": "dist/cabelo.mjs",
  "unpkg": "dist/cabelo.min.js",
  "jsdelivr": "dist/cabelo.min.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/cabelo.mjs",
      "require": "./dist/cabelo.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm test && npm run build",
    "release": "np --no-yarn"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "jsdom": "^27.0.0",
    "np": "^10.2.0",
    "rollup": "^4.50.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
